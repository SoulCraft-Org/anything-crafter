{
  "_README": [
    "Starter AI merge policy for tools/merge_policy.py (skills/merging/outside.md).",
    "Copy it beside your copy of merge_policy.py, then set ai_mergeable to the",
    "paths an outside PR may change with no maintainer. The starter grants content",
    "by extension only (Markdown, JSON, YAML, images), never code: a test, a script",
    "or a page with code runs in CI or at build time.",
    "Default deny: a path on neither list is not AI-mergeable. maintainer_only wins",
    "over ai_mergeable. Every path that runs at build or install time, defines a",
    "gate, or states the rules belongs in maintainer_only.",
    "samples: each group is a list of PR path lists; --self-test checks them, and",
    "a policy with an empty group fails it."
  ],
  "maintainer_only": [
    ".github/**",
    ".githooks/**",
    ".husky/**",
    ".claude/**",
    ".devcontainer/**",
    "tools/**",
    "scripts/**",
    "**/migrations/**",
    "**/package.json",
    "**/package-lock.json",
    "**/npm-shrinkwrap.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/pyproject.toml",
    "**/uv.lock",
    "**/requirements*.txt",
    "**/Pipfile*",
    "**/Dockerfile*",
    "**/*.config.js",
    "**/*.config.cjs",
    "**/*.config.mjs",
    "**/*.config.ts",
    "**/wrangler.toml",
    "**/wrangler.json",
    "**/wrangler.jsonc",
    "**/.npmrc",
    "**/.nvmrc",
    "**/.gitignore",
    "**/.gitattributes",
    "**/.env*",
    "merge_policy.json",
    "LICENSE",
    "NOTICE",
    "CODEOWNERS",
    "**/AGENTS.md",
    "**/CLAUDE.md",
    "GOVERNANCE.md",
    "MAINTAINERS.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "**/_worker.js",
    "**/_headers",
    "**/_redirects",
    "tests/**",
    "**/*.test.*",
    "**/conftest.py",
    "**/*.svg",
    "**/.claude/**",
    "skills/**",
    "agents/**",
    ".claude-plugin/**",
    ".codex-plugin/**",
    ".cursor-plugin/**",
    "evals/**"
  ],
  "ai_mergeable": [
    "examples/**"
  ],
  "samples": {
    "ai_mergeable": [
      [
        "examples/second-craft/README.md",
        "examples/second-craft/craft/brief.md"
      ],
      [
        "examples/second-craft/build/index.html"
      ]
    ],
    "maintainer_only": [
      [
        ".github/workflows/ci.yml"
      ],
      [
        "skills/craft/SKILL.md"
      ],
      [
        "skills/craft/guides/web-app.md"
      ],
      [
        "agents/checker.md"
      ],
      [
        ".claude-plugin/plugin.json"
      ],
      [
        ".codex-plugin/plugin.json"
      ],
      [
        ".cursor-plugin/plugin.json"
      ],
      [
        "tools/merge_policy.py"
      ],
      [
        "tests/structure.test.mjs"
      ],
      [
        "CLAUDE.md"
      ],
      [
        "examples/second-craft/README.md",
        "skills/craft/SKILL.md"
      ],
      [
        "evals/study-a-page/prompt.md"
      ]
    ],
    "default_deny": [
      [
        "README.md"
      ],
      [
        "PASTE.md"
      ],
      [
        "assets/demo.png"
      ],
      [
        "docs/notes.md"
      ]
    ],
    "refused": [
      [
        "src/../.github/workflows/ci.yml"
      ],
      [
        "/etc/hosts"
      ],
      [
        "src//pages/x.md"
      ],
      [
        "src\\pages\\x.md"
      ]
    ]
  }
}
